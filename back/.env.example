# ── DB (로컬 MySQL) ────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=gshared
MYSQL_USER=gshared
MYSQL_PASSWORD=

# ── 인증 ───────────────────────────────────────────
# HS256 서명 키. 32자 이상이어야 하며 짧으면 기동에 실패합니다.
# 생성 예: openssl rand -base64 48
JWT_SECRET=

# ── 지갑 연결 (선택) ────────────────────────────────
# domain/uri 는 application-local.yml 이 localhost:3000 으로 덮으므로 여기서 설정할 필요가 없습니다.
# 로컬 Hardhat 노드에 붙여 테스트할 때만 체인 ID 를 덮어씁니다. (기본값 31221 = SSAFY 체인)
# WALLET_AUTH_CHAIN_ID=31337

# ── 오브젝트 스토리지 (선택) ─────────────────────────
# 워커가 접속하는 Backend 주소. 서명 URL 앞에 붙습니다. 기본값 http://localhost:8080
# STORAGE_PUBLIC_BASE_URL=http://localhost:8080
# URL 서명 키. 비우면 JWT_SECRET 을 겸용합니다.
# STORAGE_SIGNING_SECRET=
# 파일을 둘 디렉터리. 기본값 ./storage-data (git 에 올라가지 않음)
# STORAGE_ROOT=./storage-data

# ── 에스크로 (선택) ───────────────────────────────────
# 배포된 GPUJobEscrow 컨트랙트 주소. 비우면 execution-context 의 contractAddress 가 비어 나갑니다.
# ESCROW_CONTRACT_ADDRESS=
