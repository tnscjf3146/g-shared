# docker-compose 가 참조하는 환경변수 견본. (운영/배포용)
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요. (.env 는 git 에 올라가지 않음)
#
# backend 컨테이너는 env_file 로 이 값을 통째로 받아 prod 프로필로 기동합니다.
# 로컬에서 IDE 로 직접 띄울 때는 이 파일이 아니라 back/.env 를 씁니다.

# ── DB ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=gshared
MYSQL_USER=gshared
MYSQL_PASSWORD=

# ── 인증 ───────────────────────────────────────────
# HS256 서명 키. 32자 이상이어야 하며 짧으면 기동에 실패합니다.
# 생성 예: openssl rand -base64 48
JWT_SECRET=

# ── CORS ──────────────────────────────────────────
# 브라우저에서 API 를 호출할 수 있는 출처. 프론트 주소를 스킴·포트까지 정확히 적습니다.
# 같은 EC2 라도 포트가 다르면 다른 출처이므로 반드시 필요합니다. 여러 개면 쉼표로 구분.
# 예: http://j15e204.p.ssafy.io  (운영 nginx 가 80 으로 받으므로 포트 없음)
# 비어 있으면 기동에 실패합니다.
CORS_ALLOWED_ORIGINS=

# ── 지갑 연결 ───────────────────────────────────────
# 서명 원문 첫 줄에 그대로 노출되어 사용자가 MetaMask 팝업에서 읽는 값입니다.
# 사용자가 실제로 접속하는 프론트 주소여야 피싱 방지 효과가 있습니다.
# 비어 있으면 prod 기동에 실패합니다.
# 스킴 없이. 예: j15e204.p.ssafy.io
WALLET_AUTH_DOMAIN=
# 스킴 포함. 예: http://j15e204.p.ssafy.io
WALLET_AUTH_URI=

# ── 선택값 (기본값이 있어 비워둬도 됩니다) ──────────────
# MYSQL_HOST=mysql           # compose 서비스 이름
# REDIS_HOST=redis
# WALLET_AUTH_CHAIN_ID=31221 # GCoin 이 배포된 SSAFY 체인. 로컬 Hardhat 노드면 31337

# ── 오브젝트 스토리지 ─────────────────────────────────
# 워커(공급자 PC)가 데이터셋을 내려받고 결과물을 올릴 때 접속하는 Backend 주소.
# 서명 URL 앞에 그대로 붙으므로 바깥에서 닿는 주소여야 합니다. 예: http://j15e204.p.ssafy.io:8080
# 비어 있으면 기동에 실패합니다.
STORAGE_PUBLIC_BASE_URL=
# URL 서명 키. 비우면 JWT_SECRET 을 겸용합니다. 생성 예: openssl rand -base64 48
# STORAGE_SIGNING_SECRET=

# ── 에스크로 ──────────────────────────────────────────
# 배포된 GPUJobEscrow 컨트랙트 주소. Worker 가 acceptJob 전에 이 주소의 온체인 값과 대조합니다.
ESCROW_CONTRACT_ADDRESS=
