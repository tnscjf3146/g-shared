# G-shared nginx 리버스 프록시 설정
# 서버 위치: /etc/nginx/sites-available/default (직접설치 nginx)
# 이 파일은 서버 설정의 "기록/백업본"입니다. 반영 방법은 같은 폴더 README.md 참고.
#
# /api → 백엔드(8080), / → 프론트(3000), /ws → 백엔드 WebSocket(8080)
# /grafana → 관제 Grafana(3001, infra/observability 의 별도 compose)
# 443(https/wss)은 certbot 관리. 워커는 wss(443)로 붙으므로 /ws 는 443 블록에 있음.

# WebSocket 업그레이드 판별. Upgrade 헤더가 있을 때만 Connection: upgrade 를 보낸다.
# /ws 처럼 전부 WebSocket 인 경로는 "upgrade" 를 그냥 박아도 되지만, /grafana 는 평범한
# HTTP 요청이 대부분이라 그렇게 하면 일반 요청까지 업그레이드로 표시돼 어긋난다.
# 서명 URL 이 접근 로그에 남지 않게 한다.
#
# 기본 combined 포맷은 `$request`(요청 줄 전체)를 남기는데, `/api/storage/**` 의 서명 URL
# 에는 `sig=` 가 들어 있고 유효 시간이 다운로드 2시간, 업로드 1시간이다. 로그를 읽을 수
# 있는 사람이 그 줄을 복사해 그대로 쓰면 데이터셋과 결과물을 가져갈 수 있고, complete
# 이전 작업이라면 result.tar 를 덮어쓰는 PUT 까지 된다.
#
# Grafana 를 /grafana 로 공개하면서 실제 문제가 됐다. 값만 지우고 `sig=` 라는 이름과
# `expires=` 는 남긴다. 어떤 요청이었는지는 여전히 추적할 수 있어야 하기 때문이다.
#
# `~*` 로 대소문자를 무시한다. 백엔드는 소문자로 내보내지만 로그에 적히는 것은 클라이언트가
# 보낸 그대로라서, 대문자로 바꿔 보내면 소문자만 찾는 규칙을 그냥 지나간다.
#
# **이 map 은 한 번만 치환한다.** `(.*)` 가 탐욕적이라 같은 이름이 두 번 이상 나오면
# 마지막 것만 가려진다. nginx map 에는 전역 치환이 없어서 여기서는 여기까지가 한계다.
# Alloy 의 `loki.process "redact"` 가 대소문자를 무시하고 **모두** 치환하므로 Loki 에
#들어가는 시점에는 남지 않는다. 가림을 두 겹으로 둔 이유가 여기서도 값을 한다.
map $args $args_redacted {
    ~*^(.*)sig=[^&]*(.*)$  "$1sig=REDACTED$2";
    default                $args;
}

# 쿼리가 없을 때 `?` 만 덩그러니 붙는 것을 막는다.
map $args_redacted $query_suffix {
    ""      "";
    default "?$args_redacted";
}

log_format gshared '$remote_addr - $remote_user [$time_local] '
                   '"$request_method $uri$query_suffix $server_protocol" '
                   '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log /var/log/nginx/access.log gshared;

    location /api {
        proxy_pass http://localhost:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location / {
        proxy_pass http://localhost:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    server_name j15e204.p.ssafy.io; # managed by Certbot
    access_log /var/log/nginx/access.log gshared;

    location /api {
        proxy_pass http://localhost:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 서명 URL 스토리지(/api/storage/**) — 데이터셋 업로드·결과물 업/다운로드가 이 경로로 지나간다.
        # 기본값(1M 본문·60s)이면 큰 파일이 413 이나 타임아웃으로 끊긴다.
        client_max_body_size    5G;
        proxy_request_buffering off;
        proxy_read_timeout      3600s;
        proxy_send_timeout      3600s;
    }

    # Worker WebSocket — 연결 업그레이드(Upgrade/Connection) + 장시간 유지(read_timeout)
    location /ws/ {
        proxy_pass http://localhost:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    # 관제 Grafana — 로그 조회 화면. infra/observability 의 별도 compose 가 띄운다.
    # 그쪽은 127.0.0.1:3001 에만 묶여 있어서, 인터넷에서 들어오는 길은 여기 하나뿐이다.
    #
    # proxy_pass 뒤에 슬래시를 붙이지 않는다. 붙이면 nginx 가 /grafana 를 떼고 넘기는데,
    # Grafana 는 GF_SERVER_SERVE_FROM_SUB_PATH=true 로 자기가 /grafana 접두어를 붙여
    # 응답하므로 경로를 그대로 넘겨야 정적 자원과 redirect 가 맞는다.
    # 슬래시 없이 들어온 것은 붙여서 되돌려 보낸다. 이렇게 나눠야 아래를 `/grafana/` 로
    # 좁힐 수 있다. `location /grafana` 하나로 두면 `/grafanafoo` 같은 것까지 걸린다.
    location = /grafana {
        return 301 https://$host/grafana/;
    }

    location /grafana/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # TLS 가 nginx 에서 끊기므로 원래 스킴을 알려 준다. 없으면 로그인 뒤 리다이렉트가
        # http 로 떨어져 브라우저가 막는다.
        proxy_set_header X-Forwarded-Proto $scheme;

        # Grafana Live(화면 실시간 갱신)가 WebSocket 을 쓴다. 기본 60초로 두면 조용한
        # 연결이 끊겨 화면이 재접속을 되풀이하므로, /ws 와 같은 값으로 올린다.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://localhost:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/j15e204.p.ssafy.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/j15e204.p.ssafy.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = j15e204.p.ssafy.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name j15e204.p.ssafy.io;
    return 404; # managed by Certbot
}
