# infra/observability/.env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
# 비워 두면 Grafana 가 기동을 거부한다. admin/admin 으로 뜨는 것을 막기 위해서다.
GRAFANA_ADMIN_PASSWORD=

# 백엔드 파일 로그가 있는 호스트 경로. 비우면 운영 서버 기준 기본값을 쓴다.
# 다른 환경(로컬 시험 등)에서 띄울 때만 바꾸면 된다.
# BACKEND_LOG_DIR=/home/ubuntu/S15P21E204/logs

# nginx 의 /grafana 경로로 서비스할 때 Grafana 가 자기 주소를 아는 값. 비우면 운영 서버
# 기준 기본값(https://j15e204.p.ssafy.io/grafana/)을 쓴다. 끝 슬래시가 필요하다.
#
# 로컬에서 nginx 없이 띄워 볼 때는 http://localhost:3001/ 로 두고,
# docker-compose.yml 의 GF_SERVER_SERVE_FROM_SUB_PATH 를 false 로 바꾼다.
# GRAFANA_ROOT_URL=https://j15e204.p.ssafy.io/grafana/
