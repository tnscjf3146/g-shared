# Copy to .env. Use confirmed SSAFY network values.
SSAFY_RPC_URL=
SSAFY_CHAIN_ID=
# Deployment wallet key: 0x + 64 hex characters. Never commit or share.
SSAFY_PRIVATE_KEY=
# Public address receiving all 1,000,000 GSC. No default to the deployer.
GSC_INITIAL_HOLDER=
# Optional for read-only verification; otherwise use the Ignition record.
GSC_CONTRACT_ADDRESS=
